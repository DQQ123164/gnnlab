# Copy this file to .env and replace the placeholders with local paths.
GNNLAB_ROOT=/path/to/gnnlab
ST_GCN_ROOT=/path/to/...
GCNLAB_ROOT=/path/to/...

# Derived dataset paths normally do not need to be changed.
GNNLAB_DSG_DIR=${GNNLAB_ROOT}/dsg
GNNLAB_SSG_DIR=${GNNLAB_ROOT}/ssg
GNNLAB_PROCESSED_DIR=${GNNLAB_ROOT}/processed

# Optional: required only when exporting DSG from an NTU60 annotation file.
NTU60_ANNOTATION_FILE=
